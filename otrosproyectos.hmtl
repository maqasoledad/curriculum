  <main>

    <!-- Carrusel YouTube -->
    <section class="card-section">
      <h2>Videos Destacados</h2>
      <div class="carousel-yt">
        <div class="yt-slides" id="yt-slides">

          <div class="yt-slide">
            <a href="https://www.youtube.com/@patriarcalmentereversada" target="_blank">
              <div class="yt-play-icon">▶</div>
              <span class="yt-title">Mapocho Poetry Slam — Presentación</span>
              <span class="yt-sub">Ver en YouTube →</span>
            </a>
          </div>

          <div class="yt-slide">
            <a href="https://www.youtube.com/watch?v=TU_VIDEO_2" target="_blank">
              <div class="yt-play-icon">▶</div>
              <span class="yt-title">Rap &amp; Vida — Track destacado</span>
              <span class="yt-sub">Ver en YouTube →</span>
            </a>
          </div>

          <div class="yt-slide">
            <a href="https://www.youtube.com/watch?v=TU_VIDEO_3" target="_blank">
              <div class="yt-play-icon">▶</div>
              <span class="yt-title">Colectivo Alma HipHop — Evento</span>
              <span class="yt-sub">Ver en YouTube →</span>
            </a>
          </div>

          <div class="yt-slide">
            <a href="https://www.youtube.com/watch?v=TU_VIDEO_4" target="_blank">
              <div class="yt-play-icon">▶</div>
              <span class="yt-title">Women's Health — Taller</span>
              <span class="yt-sub">Ver en YouTube →</span>
            </a>
          </div>

        </div>
        <button class="btn-prev" onclick="moveYT(-1)">&#8249;</button>
        <button class="btn-next" onclick="moveYT(1)">&#8250;</button>
      </div>
    </section>

    <!-- Tabla 4 columnas de proyectos -->
    <section class="card-section">
      <h2>Mis Proyectos</h2>
      <div class="proyectos-grid">

        <div class="proyecto-col">
          <h3>Mapocho Poetry Slam</h3>
          <p>Participación activa en eventos de poetry slam a orillas del Mapocho. Espacio de expresión oral, poesía en vivo y encuentro cultural independiente.</p>
          <a class="btn-link" href="https://www.instagram.com/patriarcalmentereversada" target="_blank">Ver más</a>
        </div>

        <div class="proyecto-col">
          <h3>Rap &amp; Vida</h3>
          <p>Proyecto musical que fusiona rap consciente con experiencias cotidianas. Talleres, composición y presentaciones en espacios comunitarios.</p>
          <a class="btn-link" href="https://www.youtube.com/@patriarcalmentereversada" target="_blank">Escuchar</a>
        </div>

        <div class="proyecto-col">
          <h3>Colectivo Alma HipHop</h3>
          <p>Colectivo de cultura hip-hop enfocado en arte urbano, música y comunidad. Organización de eventos, cypher y talleres formativos.</p>
          <a class="btn-link" href="https://www.instagram.com/patriarcalmentereversada" target="_blank">Ver más</a>
        </div>

        <div class="proyecto-col">
          <h3>Women's Health</h3>
          <p>Talleres y actividades orientadas al bienestar femenino, salud integral y acompañamiento colectivo entre mujeres.</p>
          <a class="btn-link" href="https://www.instagram.com/patriarcalmentereversada" target="_blank">Ver más</a>
        </div>

      </div>
    </section>

  </main>

  <footer>
    <div class="redes-sociales">
      <a href="https://www.youtube.com/@patriarcalmentereversada" target="_blank">▶ YouTube</a>
      <a href="https://www.instagram.com/patriarcalmentereversada" target="_blank">📷 Instagram</a>
