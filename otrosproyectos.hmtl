    </div>
    <p>&copy; 2024 Maqarena Soledad. Todos los derechos reservados.</p>
  </footer>

  <script src="./static/js/carousel.js"></script>
  <script>
    // Carrusel YouTube independiente
    let ytCurrent = 0;
    function moveYT(dir) {
      const slides = document.querySelectorAll('.yt-slide');
      ytCurrent = (ytCurrent + dir + slides.length) % slides.length;
      document.getElementById('yt-slides').style.transform = `translateX(-${ytCurrent * 100}%)`;
    }
    // Autoplay cada 5 segundos
    let ytTimer = setInterval(() => moveYT(1), 5000);
    const cyt = document.querySelector('.carousel-yt');
    if (cyt) {
      cyt.addEventListener('mouseenter', () => clearInterval(ytTimer));
      cyt.addEventListener('mouseleave', () => { ytTimer = setInterval(() => moveYT(1), 5000); });
    }
  </script>

</body>
</html>
